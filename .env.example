# --- database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zerocams
DB_PASSWORD=change_me
DB_NAME=zerocams

# --- JWT: four different random secrets (python3 -c "import secrets; print(secrets.token_hex(32))") ---
JWT_SECRET_SESSION=change_me_session_secret
JWT_SECRET_ACCESS=change_me_access_secret
JWT_SECRET_ACCESS_ADMIN=change_me_access_admin_secret
JWT_SECRET_SHARE=change_me_share_secret
JWT_ALGORITHM=HS256

# --- token TTLs (seconds), all required ---
ACCESS_TOKEN_TTL_SECONDS=600
SESSION_TOKEN_TTL_SECONDS=2592000
SHARE_TOKEN_MIN_TTL_SECONDS=60
SHARE_TOKEN_MAX_TTL_SECONDS=604800

# --- push (Telegram) ---
TELEGRAM_API_BASE=https://api.telegram.org

# --- background workers ---
HEALTHCHECK_INTERVAL_SECONDS=60
HEALTHCHECK_TCP_TIMEOUT_SECONDS=5
STREAM_IDLE_TIMEOUT_SECONDS=30
ONVIF_TIMEOUT_SECONDS=10
# after the camera rejects ONVIF credentials / locks the account, do not contact it over ONVIF for this long (0 = off)
ONVIF_AUTH_BACKOFF_SECONDS=1800
SWITCH_TIMEOUT_SECONDS=10
SWITCH_SYNC_INTERVAL_SECONDS=300
CONNECTION_SYNC_INTERVAL_SECONDS=420

# --- external binaries ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- HLS streaming ---
HLS_ENABLED=false
HLS_TEMP_DIR=/tmp/zerocams/hls
HLS_SEGMENT_DURATION=2
HLS_PLAYLIST_SIZE=10
HLS_CLEANUP_INTERVAL=60
HLS_SEGMENT_MAX_AGE=300
HLS_IDLE_TIMEOUT_SECONDS=30
# stage 3: with INGEST_ENABLED and an online hub, HLS ffmpeg reads the hub (started on the
# first playlist request, stopped HLS_IDLE_TIMEOUT_SECONDS after the last request); otherwise direct RTSP.
# ffmpeg must list a first segment within this many seconds (else fallback to direct / error)
HLS_START_TIMEOUT_SECONDS=10
# no new segment for this long -> kill ffmpeg; the next request starts it again
HLS_STALL_SECONDS=15

# --- WebRTC streaming ---
WEBRTC_ENABLED=false
WEBRTC_STUN_SERVER=
WEBRTC_TURN_SERVER=
WEBRTC_TURN_SECRET=
WEBRTC_ICE_TIMEOUT_SECONDS=10
WEBRTC_MAX_BITRATE=2000000
# публичный IP сервера: добавляется в SDP как server-reflexive кандидат (порты UDP проброшены 1:1);
# работает только вместе с WEBRTC_UDP_PORT_MIN/MAX (диапазон должен быть открыт снаружи)
WEBRTC_PUBLIC_IP=
# диапазон локальных UDP-портов ICE (0/0 = эфемерный диапазон ОС), например 49152..65535
WEBRTC_UDP_PORT_MIN=0
WEBRTC_UDP_PORT_MAX=0
# необязательный TLS/TCP-вариант TURN для клиентов, например turns:turn.example.com:5349
WEBRTC_TURNS_SERVER=
# срок жизни временных TURN-учётных данных (GET /v1/webrtc/ice)
WEBRTC_TURN_CREDENTIAL_TTL_SECONDS=3600
# убирать из SDP, отдаваемого клиенту, приватные/loopback/link-local/CGNAT адреса
WEBRTC_HIDE_PRIVATE_CANDIDATES=true
WEBRTC_FIRST_FRAME_TIMEOUT_SECONDS=15
WEBRTC_STALL_SECONDS=10
WEBRTC_MAX_LATENCY_MS=500  # плюс размер пачки кадров (GOP), см. track.py

# --- ingest (persistent per-camera ffmpeg -> in-memory fMP4 hub) ---
# With ingest on, /stream, HLS, WebRTC, live snapshots and motion detection read the hub:
# the camera keeps ONE RTSP session of ours (each consumer falls back to direct RTSP if the hub is unavailable).
# When false no process is started and app behaviour is unchanged.
INGEST_ENABLED=false
# no bytes for this many seconds -> kill and restart ingest (half-open TCP)
INGEST_STALL_SECONDS=10
# planned restart per camera at a random time in [min, max] minutes, only without viewers
INGEST_RESTART_MIN_MINUTES=30
INGEST_RESTART_MAX_MINUTES=60
# cap of the buffered last GOP per camera, bytes
INGEST_MAX_BUFFER_BYTES=16777216
# restart pause after a crash: 1,2,4... seconds, up to this
INGEST_BACKOFF_MAX_SECONDS=30
# overall time budget to stop all ingest processes at shutdown (then SIGKILL)
INGEST_STOP_TIMEOUT_SECONDS=8
# process registry dir; empty = CACHE_DIR/ingest
INGEST_REGISTRY_DIR=
# stage 2: GET /stream is served from the hub by an on-demand transcoder (needs INGEST_ENABLED).
# The transcoder starts with the first viewer and stays this many seconds after the last one left
# (ingest itself keeps running); a viewer arriving meanwhile attaches instantly.
INGEST_IDLE_TRANSCODE_LINGER_SECONDS=45
# hub not online yet: wait this long, then fall back to the direct RTSP ffmpeg
INGEST_HUB_WAIT_SECONDS=5
# transcoder produced nothing for this long -> kill it (viewers reconnect)
INGEST_TRANSCODE_STALL_SECONDS=15
# stage 5: GET /cams/{id}/snapshot (when ONVIF is off/failed) is decoded from the hub's init + last GOP
# by a local ffmpeg (no camera connection); no fed hub with a stored GOP within this many seconds -> direct RTSP
INGEST_SNAPSHOT_HUB_WAIT_SECONDS=2
INGEST_SNAPSHOT_TIMEOUT_SECONDS=10
INGEST_SNAPSHOT_MAX_PARALLEL=4
# stage 5: motion detection decodes the hub through a local ffmpeg (1 fps, native size) instead of its own RTSP;
# no first frame within this -> direct RTSP; decoder silent for STALL seconds -> restart the source
INGEST_MOTION_FIRST_FRAME_TIMEOUT_SECONDS=20
INGEST_MOTION_STALL_SECONDS=15
# decoded frames older than this are dropped without analysis/push (hub delivers a GOP at a time)
INGEST_MOTION_MAX_FRAME_AGE_SECONDS=10
# consecutive failed starts of the detection source (no frame) before the session gives up
INGEST_MOTION_RESTART_ATTEMPTS=5

# --- misc ---
CACHE_DIR=caching
# Motion event photos (relative paths are resolved from the project root)
MOTION_FILES_DIR=motion_files
HOST=0.0.0.0
PORT=8000
VERSION=v1.0.0-Release

# --- logging ---
LOGGING_LEVEL=INFO
LOGGING_SCOPE=general
# true: one INFO line per motion-detection frame with all YOLO detections (before filters) and the verdict
MOTION_DEBUG_LOG=false
